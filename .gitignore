/data/
*.db
*.db-shm
*.db-wal
*.db-journal

# Frontend
/webui/node_modules/
/webui/dist/
/.npm-cache/
coverage/

# Python compatibility tooling
/.venv-py311/
/.uv-cache/
/.uv-python/
__pycache__/
*.py[cod]

# MCP server (Python, mcp/): the venv, caches and lock are local. The lock is
# not committed because scripts/bump-version.py keeps mcp/pyproject.toml in
# step with the release version, and a committed lock would then need a second
# rewrite; `uvx` resolves and caches on first run instead. Drift that a lock
# would have hidden is caught by CI instead: it runs the tests against the
# newest SDK and against the floor declared in pyproject.toml.
/mcp/.venv/
/mcp/.venv-floor/
/mcp/.ruff_cache/
/mcp/.pytest_cache/
/mcp/uv.lock

# Local configuration and diagnostics
.env
.env.*
!.env.example
*.log

# Editors and operating systems
.idea/
.workbuddy/
.vscode/
.DS_Store
Thumbs.db
Desktop.ini

# pi session exports
pi-session-*.html
