BIND=0.0.0.0
PORT=8923
DATABASE_URL=sqlite://data/qd.db
# MySQL backend: DATABASE_URL=mysql://user:password@host:3306/qdrust
DATABASE_MIN_CONNECTIONS=1
DATABASE_MAX_CONNECTIONS=8
RUST_LOG=qdrust=info,tower_http=info
SCHEDULER_INTERVAL_SECONDS=15
REQUEST_TIMEOUT_SECONDS=30
SESSION_TTL_SECONDS=604800
COOKIE_SECURE=false
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=60

# Run log retention (0 = keep forever). Old finished runs are pruned hourly.
LOG_RETENTION_DAYS=0

# IANA timezone applied to cron scheduling when a task does not set its own
# timezone (WebUI lets you leave a task's timezone blank). Defaults to
# Asia/Shanghai; set e.g. America/New_York for a DST-aware deployment.
QDRUST_DEFAULT_TIMEZONE=Asia/Shanghai

# URL sub-path to serve the site under when reverse-proxying to a directory,
# e.g. "/qd" for https://host/qd. Leave empty to serve at the root (default).
#
# The WebUI is built with a RELATIVE base and derives the prefix from the page
# URL at runtime, so you do NOT need to rebuild it per prefix — just set this to
# the actual reverse-proxy prefix so the backend serves /<prefix>/assets/* and
# the SPA under that directory (reverse-proxy must NOT strip the prefix).
# Liveness probes /health and /ready stay at the bare root.
#
# Optional build-time pinning (legacy): building the UI with
# VITE_BASE_PATH=<same value> produces an absolute-base UI instead.
QDRUST_BASE_PATH=

# SMTP email notifications (password reset + email verification + email channels)
QDRUST_SMTP_HOST=
QDRUST_SMTP_PORT=587
QDRUST_SMTP_USERNAME=
QDRUST_SMTP_PASSWORD=
QDRUST_SMTP_FROM=

# Base URL used in password-reset and email-verification links
QDRUST_BASE_URL=http://localhost:8923

# Require new users to verify their email address before logging in
REQUIRE_EMAIL_VERIFICATION=false

# Google Analytics key injected into the WebUI index.html
GA_KEY=

# Optional Redis session cache (sessions also validated against SQLite)
REDIS_URL=

# Optional JSON config file for runtime-tunable settings (local_config equivalent).
# Supported keys: bind, port, database_url, scheduler_interval_seconds,
# request_timeout_seconds, log_retention_days, ga_key, require_email_verification,
# default_timezone, base_path
QDRUST_CONFIG_FILE=

# Browser automation plugin (api://browser/<action>).
# Set QDRUST_BROWSER_URL to a remote CDP endpoint to enable it. chromiumoxide
# runs in-process inside qdrust-server (no separate subprocess binary needed):
#   local Chromium/obscura: http://localhost:9222
#   Browserless self-hosted: ws://localhost:3000
#   Browserless cloud: wss://chrome.browserless.io?token=<TOKEN>
QDRUST_BROWSER_URL=
